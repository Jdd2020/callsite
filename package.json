{
  "name": "callsite",
  "displayName": "Callsite: All Usages in One View",
  "description": "Explore every reference to a symbol: a folder tree of usages with file-by-file stepping.",
  "version": "0.0.1",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Jdd2020/callsite.git"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "callsite.showUsages",
        "title": "Show Usages",
        "category": "Callsite"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "callsite.showUsages",
          "when": "editorHasReferenceProvider",
          "group": "navigation"
        }
      ],
      "commandPalette": [
        {
          "command": "callsite.showUsages",
          "when": "editorIsOpen"
        }
      ]
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "callsite",
          "title": "Callsite",
          "icon": "media/callsite.svg"
        }
      ]
    },
    "views": {
      "callsite": [
        {
          "id": "callsite.usages",
          "name": "Usages"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "callsite.usages",
        "contents": "Put the cursor on a symbol and run Callsite: Show Usages to see every reference to it.\n[Show Usages](command:callsite.showUsages)"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "npm run check-types && npm run lint && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "npm run check-types && npm run lint && node esbuild.js --production",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "check-types": "tsc --noEmit && tsc --noEmit -p test/unit && tsc --noEmit -p test/fixture",
    "lint": "eslint src test",
    "test": "npm run test:unit && npm run test:integration",
    "test:unit": "vitest run",
    "pretest:integration": "npm run compile-tests && npm run compile",
    "test:integration": "vscode-test"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "24.x",
    "@types/vscode": "~1.90.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.0.0",
    "esbuild": "^0.28.1",
    "eslint": "^10.5.0",
    "npm-run-all": "^4.1.5",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.1",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6"
  }
}
